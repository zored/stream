<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.zored.stream.zored_stream</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/bin/zored_stream</string>
		<string>-usage-proxy=@USAGE_PROXY@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/zored-stream/zored_stream.log</string>
</dict>
</plist>
